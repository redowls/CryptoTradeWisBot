# ----------------------------------------------------------------------------
# .env — copy to ".env" and fill in. This file holds the SQL Server connection
# string and the encryption master key ONLY. Every other credential (Alpaca
# keys, Telegram token/chat id) and all tunable parameters live in the
# `app_config` DB table, read exclusively through config_store.py.
# Do NOT add API keys here.
# ----------------------------------------------------------------------------

# Full SQLAlchemy URL for Microsoft SQL Server via pyodbc + ODBC Driver 18.
# Format:
#   mssql+pyodbc://<user>:<password>@<host>:<port>/<database>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
#
# Example (local dev / self-signed cert):
#   DATABASE_URL=mssql+pyodbc://sa:YourStrong%40Passw0rd@localhost:1433/CryptoBot?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
#
# Notes:
#  - URL-encode special characters in the password (@ -> %40, etc.).
#  - Encrypt=yes is required by Driver 18; TrustServerCertificate=yes only for
#    self-signed certs (a dev box). Use a real cert in production.
DATABASE_URL=

# Fernet master key that encrypts is_secret rows in app_config (Phase 15).
# Generate one:  python -m crypto_bot.config_store genkey
# Keep it OUT of the database and out of git. If unset, secrets fall back to
# plaintext (a warning is logged). After setting it, encrypt existing secrets:
#   python -m crypto_bot.config_store migrate
CRYPTO_BOT_MASTER_KEY=
